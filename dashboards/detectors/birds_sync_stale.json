{
  "id": "<DETECTOR_ID_BIRDS_SYNC_STALE>",
  "name": "Birds sync stale",
  "description": "Birds sync age above 2 hours for 1 hour 15 minutes.",
  "programText": "signal = data('grokbot.birds.sync.age_seconds')\ndetect(when(signal > 7200, lasting='1h15m')).publish('Birds sync stale')\n",
  "rules": [
    {
      "detectLabel": "Birds sync stale",
      "disabled": false,
      "notifications": [
        {
          "type": "Email",
          "bcc": [],
          "cc": [],
          "email": "alerts@example.com"
        }
      ],
      "parameterizedBody": "Birds sync stale is {{status}} at {{timestamp}}.",
      "parameterizedSubject": "Birds sync stale triggered",
      "severity": "Warning"
    }
  ],
  "maxDelay": 0,
  "minDelay": null,
  "timezone": null,
  "tags": [],
  "detectorOrigin": "Standard"
}

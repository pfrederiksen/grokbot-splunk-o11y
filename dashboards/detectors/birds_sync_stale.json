          "cc": [],
          "bcc": []
        }
      ],
      "parameterizedSubject": "Grok Bot birds sync stale",
      "parameterizedBody": "Bird-detection sync is older than 2h for 2 samples. Fix: rerun the hourly sync and check that its environment is intact.",
      "severity": "Warning"

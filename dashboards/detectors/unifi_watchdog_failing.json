{
  "id": "<DETECTOR_ID_UNIFI_WATCHDOG_FAILING>",
  "name": "UniFi watchdog failing",
  "description": "Network extras-poller watchdog (grokbot.home.unifi.watchdog_ok) stayed at 0 for 1 hour 15 minutes.",
  "programText": "ok = data('grokbot.home.unifi.watchdog_ok').publish('signal')\ndetect(when(ok < 1, lasting='1h15m')).publish('UniFi watchdog failing')\n",
  "rules": [
    {
      "detectLabel": "UniFi watchdog failing",
      "disabled": false,
      "notifications": [
        {
          "type": "Email",
          "email": "alerts@example.com",
          "cc": [],
          "bcc": []
        }
      ],
      "parameterizedSubject": "Grok Bot network watchdog failing",
      "parameterizedBody": "The network extras-poller watchdog is not ok. Fix: check the watchdog status file and restart the loop if it has stopped.",
      "severity": "Warning"
    }
  ],
  "maxDelay": 0,
  "minDelay": null,
  "timezone": null,
  "tags": [],
  "detectorOrigin": "Standard"
}

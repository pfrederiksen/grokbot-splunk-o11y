{
  "id": "<DETECTOR_ID_EMAIL_SYNC_STALE>",
  "name": "Email sync stale",
  "description": "Email sync age exceeded 9 hours for 1 hour 15 minutes.",
  "programText": "age = data('grokbot.email.sync.age_seconds').publish('signal')\ndetect(when(age > 32400, lasting='1h15m')).publish('Email sync stale')\n",
  "rules": [
    {
      "detectLabel": "Email sync stale",
      "disabled": false,
      "notifications": [
        {
          "type": "Email",
          "email": "alerts@example.com",
          "cc": [],
          "bcc": []
        }
      ],
      "parameterizedSubject": "Grok Bot email sync stale",
      "parameterizedBody": "Email sync is older than 9h. Fix: rerun the email refresh routine; transient mailbox errors usually clear on retry.",
      "severity": "Warning"
    }
  ],
  "maxDelay": 0,
  "minDelay": null,
  "timezone": null,
  "tags": [],
  "detectorOrigin": "Standard"
}

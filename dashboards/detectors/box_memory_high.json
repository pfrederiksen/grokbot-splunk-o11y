{
  "id": "<DETECTOR_ID_BOX_MEMORY_HIGH>",
  "name": "Box memory high",
  "description": "Memory used percent stayed above 90 for 1 hour 15 minutes.",
  "programText": "mem = data('grokbot.box.mem.pct').publish('signal')\ndetect(when(mem > 90, lasting='1h15m')).publish('Box memory high')\n",
  "rules": [
    {
      "detectLabel": "Box memory high",
      "disabled": false,
      "notifications": [
        {
          "type": "Email",
          "email": "alerts@example.com",
          "cc": [],
          "bcc": []
        }
      ],
      "parameterizedSubject": "Grok Bot box memory high",
      "parameterizedBody": "Box memory is {{inputs.signal.value}}% (>90%). Fix: look for runaway processes (for example leftover browsers or pollers).",
      "severity": "Major"
    }
  ],
  "maxDelay": 0,
  "minDelay": null,
  "timezone": null,
  "tags": [],
  "detectorOrigin": "Standard"
}

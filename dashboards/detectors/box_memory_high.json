        }
      ],
      "parameterizedBody": "Box memory high is {{status}} at {{timestamp}}.",
      "parameterizedSubject": "Box memory high triggered",
      "severity": "Major"
    }
  ],
  "maxDelay": 0,
  "minDelay": null,
  "timezone": null,
  "tags": [],

{
  "id": "<DETECTOR_ID_HA_DOWN>",
  "name": "HA down",
  "description": "Home Assistant reported down for 1 hour 15 minutes (hourly emitter).",
  "programText": "signal = data('grokbot.home.ha.up')\ndetect(when(signal == 0, lasting='1h15m')).publish('HA down')\n",
  "rules": [
    {
      "detectLabel": "HA down",
      "disabled": false,
      "notifications": [
        {
          "type": "Email",
          "bcc": [],
          "cc": [],
          "email": "alerts@example.com"
        }
      ],
      "parameterizedBody": "HA down is {{status}} at {{timestamp}}.",
      "parameterizedSubject": "HA down triggered",
      "severity": "Critical"
    }
  ],
  "maxDelay": 0,
  "minDelay": null,
  "timezone": null,
  "tags": [],
  "detectorOrigin": "Standard"
}

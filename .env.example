# Copy to a chmod 600 file outside git, or export these in the environment.
# Never commit real values. Placeholders only.

SPLUNK_O11Y_REALM=<REALM>
SPLUNK_O11Y_INGEST_TOKEN=<INGEST_TOKEN>
SPLUNK_O11Y_API_TOKEN=<API_TOKEN>

# Optional
GROKBOT_HOST=example-box
# GROKBOT_DISK_PATH=/
# GROKBOT_O11Y_SECRETS_DIR=/path/to/secrets
# GROKBOT_STATE_FILE=.state/emit-status.json
# SPLUNK_O11Y_INGEST_URL=https://ingest.<REALM>.signalfx.com/v2/datapoint
# SPLUNK_O11Y_API_URL=https://api.<REALM>.signalfx.com
# GROKBOT_DRY_RUN=1

# Default protocol is otlp. Do not also POST to /v2/datapoint in the same org.
# GROKBOT_O11Y_PROTOCOL=otlp
# GROKBOT_O11Y_PROTOCOL=signalfx   # legacy /v2/datapoint only
# SPLUNK_O11Y_OTLP_URL=https://ingest.<REALM>.signalfx.com/v2/datapoint/otlp
# Collector example: http://127.0.0.1:4318/v1/metrics
# SPLUNK_O11Y_OTLP_TRACES_URL=https://ingest.<REALM>.signalfx.com/v2/trace/otlp
# SPLUNK_O11Y_STREAM_URL=https://stream.<REALM>.signalfx.com/v2/signalflow/execute
# GROKBOT_DATA_ROOT=data
# GROKBOT_ENVIRONMENT=example
